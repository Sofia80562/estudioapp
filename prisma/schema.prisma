// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MÓDULO DE USUARIOS Y AUTENTICACIÓN
// ==========================================

model User {
  id                   String       @id @default(uuid()) @db.Uuid
  email                String       @unique @db.VarChar(180)
  username             String?      @unique @db.VarChar(100)
  passwordHash         String?      @map("password_hash")
  status               String       @db.VarChar(30)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  profile              UserProfile?
  authAccounts         AuthAccount[]
  sessions             UserSession[]
  userRoles            UserRole[]
  tasks                Task[]
  studyTimeLogs        StudyTimeLog[]
  auditLogs            AuditLog[]
  studySessionBookings StudySessionBooking[]

  @@map("users")
}

model UserProfile {
  userId          String    @id @map("user_id") @db.Uuid
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  identification  String?   @db.VarChar(30)
  phone           String?   @db.VarChar(16)
  
  facebookUrl     String?   @map("facebook_url") @db.VarChar(255)
  instagramUrl    String?   @map("instagram_url") @db.VarChar(255)
  linkedinUrl     String?   @map("linkedin_url") @db.VarChar(255)
  xUrl            String?   @map("x_url") @db.VarChar(255)
  githubUrl       String?   @map("github_url") @db.VarChar(255)
  tiktokUrl       String?   @map("tiktok_url") @db.VarChar(255)
  websiteUrl      String?   @map("website_url") @db.VarChar(255)
  
  avatarData      Bytes?    @map("avatar_data")
  avatarMimeType  String?   @map("avatar_mime_type") @db.VarChar(30)
  avatarUpdatedAt DateTime? @map("avatar_updated_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model AuthAccount {
  id                String @id @default(uuid()) @db.Uuid
  userId            String @map("user_id") @db.Uuid
  provider          String @db.VarChar(50)
  providerAccountId String @map("provider_account_id") @db.VarChar(200)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model UserSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  sealedTokens String   @map("sealed_tokens")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  revokedAt    DateTime @map("revoked_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ==========================================
// MÓDULO DE TAREAS Y ALERTAS (ESTUDIOAPP)
// ==========================================

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String    @db.VarChar(250)
  description String?
  status      String    @default("PENDING") @db.VarChar(30)
  priority    String    @default("MEDIUM") @db.VarChar(10)
  dueDate     DateTime? @map("due_date") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts Alert[]

  @@index([userId])
  @@map("tasks")
}

model Alert {
  id            String   @id @default(uuid()) @db.Uuid
  taskId        String   @map("task_id") @db.Uuid
  scheduledTime DateTime @map("scheduled_time") @db.Timestamptz
  sent          Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("alerts")
}

// ==========================================
// MÓDULO DE CRONÓMETRO / SESIONES DE ESTUDIO
// ==========================================

model StudyTimeLog {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  startTime       DateTime @map("start_time") @db.Timestamptz
  durationMinutes Int      @map("duration_minutes")
  sessionType     String   @map("session_type") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("study_time_logs")
}

// ==========================================
// MÓDULO DE ROLES, PERMISOS Y MENÚS
// ==========================================

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  code           String    @db.VarChar(100)
  name           String    @db.VarChar(150)
  normalizedName String    @map("normalized_name") @db.VarChar(150)
  description    String?
  isSystem       Boolean   @default(false) @map("is_system")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  module      String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  code        String   @unique @db.VarChar(200)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles RolePermission[]
  menus MenuPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String  @map("role_id") @db.Uuid
  permissionId String  @map("permission_id") @db.Uuid
  granted      Boolean @default(true)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_roles")
}

model Menu {
  id       String  @id @default(uuid()) @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  code     String  @unique @db.VarChar(100)
  name     String  @db.VarChar(150)
  route    String? @db.VarChar(255)

  parent      Menu?            @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Menu[]           @relation("MenuHierarchy")
  permissions MenuPermission[]

  @@map("menus")
}

model MenuPermission {
  menuId       String @map("menu_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  menu       Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([menuId, permissionId])
  @@map("menu_permissions")
}

// ==========================================
// MÓDULO DE AUDITORÍA
// ==========================================

enum AuditAction {
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  USER_LOGGED_IN
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String      @map("actor_user_id") @db.Uuid
  entityType  String      @map("entity_type") @db.VarChar(100)
  entityId    String      @map("entity_id") @db.Uuid
  action      AuditAction
  changes     Json?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// MÓDULO DE INSTITUCIONES Y CAMPUS / CURSOS
// ==========================================

model Institution {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(150)
  code        String?   @unique @db.VarChar(50)
  description String?
  status      String    @default("ACTIVE") @db.VarChar(30)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  campuses Campus[]
  courses  Course[]

  @@map("institutions")
}

model Campus {
  id            String    @id @default(uuid()) @db.Uuid
  institutionId String    @map("institution_id") @db.Uuid
  name          String    @db.VarChar(150)
  code          String    @db.VarChar(50)
  address       String?
  status        String    @default("ACTIVE") @db.VarChar(30)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@map("campuses")
}

model Course {
  id            String       @id @default(uuid()) @db.Uuid
  institutionId String?      @map("institution_id") @db.Uuid
  code          String       @unique @db.VarChar(50)
  title         String       @db.VarChar(150)
  description   String?
  credits       Int?         @default(0)
  semester      Int?
  status        String       @default("ACTIVE") @db.VarChar(30)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz

  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  sections      Section[]
  studySessions StudySession[]

  @@index([institutionId])
  @@map("courses")
}

// ==========================================
// MÓDULO DE SECCIONES Y MATERIALES
// ==========================================

model Section {
  id                String    @id @default(uuid()) @db.Uuid
  courseId          String    @map("course_id") @db.Uuid
  name              String    @db.VarChar(150)
  description       String?
  classroom         String?   @db.VarChar(100)
  schedule          String?   @db.VarChar(150)
  capacity          Int?
  expectedUpdatedAt DateTime? @map("expected_updated_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materials Material[]

  @@index([courseId])
  @@map("sections")
}

model Material {
  id        String   @id @default(uuid()) @db.Uuid
  sectionId String   @map("section_id") @db.Uuid
  title     String   @db.VarChar(250)
  type      String   @db.VarChar(50)
  url       String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@map("materials")
}

// ==========================================
// MÓDULO DE CALENDARIO / CLASES
// ==========================================

model StudySession {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  status    String   @default("PUBLISHED") @db.VarChar(30)
  startsAt  DateTime @map("starts_at") @db.Timestamptz
  endsAt    DateTime @map("ends_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course   Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  bookings StudySessionBooking[]

  @@index([status])
  @@index([startsAt])
  @@map("study_sessions")
}

model StudySessionBooking {
  id             String   @id @default(uuid()) @db.Uuid
  studySessionId String   @map("study_session_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  status         String   @default("CONFIRMED") @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  studySession StudySession @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([studySessionId])
  @@map("study_session_bookings")
}